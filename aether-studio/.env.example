# ==============================================================================
# Closer — AI Deal Closer & Multi-Page Commercial Proposal PDF Studio
# Environment Configuration
# ==============================================================================

# ================== REQUIRED API KEY ==================
# Your Anthropic Claude API Key — https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY="You can put your API key here"

# ============== AGENT LOCK (Standalone Single-Agent) ==============
# Locked to Closer (proposition) in standalone single-agent mode
OWNED_AGENT=proposition
NEXT_PUBLIC_OWNED_AGENT=proposition

# ============== INTEGRATIONS (Closer Proposal Studio) ==============
# Fireflies API Key for sales call transcripts & AI meeting intelligence
# Optional (demo meetings active by default)
# FIREFLIES_API_KEY="You can put your API key here"  # Optional (demo meetings active by default)

# Google Workspace OAuth (optional, for proposal delivery via Gmail)
# GOOGLE_CLIENT_ID="You can put your API key here"
# GOOGLE_CLIENT_SECRET="You can put your API key here"
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ============== OPTIONAL CONFIGURATION ==============
# Model overrides (defaults to Sonnet 4 / Opus 4)
# ANTHROPIC_MODEL_SONNET=claude-sonnet-4-20250514
# ANTHROPIC_MODEL_OPUS=claude-opus-4-20250514

# Optional URL to unlock additional agents in the AetherOS suite
# NEXT_PUBLIC_UNLOCK_URL="You can put your API key here"
